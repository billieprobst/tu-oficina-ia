# Copia este archivo como .env.local para probar en tu computadora.
# En Vercel, estas mismas variables van en tu proyecto → Settings → Environment Variables.

# --- Entrar a tu oficina ---
OFICINA_CLAVE=            # la contraseña para abrir tu oficina
SECRETO_ENTRADA=          # una frase secreta larga (24 caracteres o más). La usan Make, Zapier y Telegram.

# --- Tu IA (elige una) ---
IA_PROVEEDOR=gemini       # gemini, claude u openai
GEMINI_API_KEY=           # si usas Gemini: aistudio.google.com → Get API key
ANTHROPIC_API_KEY=        # si usas Claude: console.anthropic.com → API Keys
OPENAI_API_KEY=           # si usas OpenAI: platform.openai.com → API keys
IA_MODELO=                # opcional. Por defecto: gemini-3.8-flash, claude-opus-5-5 o gpt-5.4-mini
TOPE_MENSUAL_USD=5        # al llegar a este gasto en el mes, los agentes paran

# --- Tu Google Sheets ---
GOOGLE_SHEET_ID=          # lo que va entre /d/ y /edit en la dirección de tu hoja
GOOGLE_CUENTA_CORREO=     # el correo de tu cuenta de servicio (termina en iam.gserviceaccount.com)
GOOGLE_CUENTA_LLAVE=      # la "private_key" del archivo JSON de la cuenta de servicio, completa

# --- Tu bot de Telegram ---
TELEGRAM_BOT_TOKEN=       # el que te da @BotFather
TELEGRAM_DUENOS=          # tu número de Telegram (el bot te lo dice con /start). Varios: separados por coma
TELEGRAM_OBRA=            # los números de tu equipo de obra (residente, maestro). Opcional

# --- Tu negocio ---
NEGOCIO_TIPO=ambos        # asesor, constructor o ambos
NEGOCIO_NOMBRE=           # aparece en tu oficina y en los reportes
NEGOCIO_DESCRIPCION=      # una o dos frases: qué vendes, dónde y a quién
ZONA_HORARIA=America/Guayaquil

# --- Obra ---
OBRA_PROYECTO=            # el nombre de tu proyecto
OBRA_DIA_REPORTE=viernes  # el día que sale el reporte semanal

# --- Reloj (Vercel lo usa para el resumen diario y el reporte) ---
CRON_SECRET=              # otra frase secreta larga
